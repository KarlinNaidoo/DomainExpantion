# SpaceXAI / xAI (required for `domain-expantion chat`)
XAI_API_KEY=
XAI_MODEL=grok-4.6

# Supervisor loop guard (model calls per user turn)
SUPERVISOR_RUN_LIMIT=8

# Research specialist loop guard (model calls per brief)
RESEARCH_RUN_LIMIT=6

# Architecture specialist loop guard (model calls per brief)
ARCHITECTURE_RUN_LIMIT=8

# LangGraph thread persistence (docker compose postgres, host port 5433)
DATABASE_URL=postgresql://domain:domain@127.0.0.1:5433/domain_expantion?sslmode=disable

# Optional: override where family specs live
# DOMAIN_EXPANTION_FAMILY=./family

# Optional: GitHub MCP for research (read-only). Fine-grained PAT with public repo read.
# GITHUB_TOKEN=

# Optional traces (off by default)
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=domain-expantion
